rules_version = '2';

// UtaNote cloud backup (Phase B-3).
//
// Layout: users/{uid}/songs/{songSyncId}
//         users/{uid}/folders/{folderSyncId}
//         users/{uid}/folderSongs/{folderSyncId}_{songSyncId}
//
// - Only the signed-in owner (request.auth.uid == uid) can read or write.
// - Sync never hard-deletes; a deletion is `deleted: true`. The only hard
//   delete is account deletion (Phase B-5), allowed for the owner only.
// - A deleted song/folder can't be turned back into a live one; a deleted
//   membership only with a higher revision (explicit re-add, see below).
// - Document ids must match the sync ids inside them.
// - Account deletion (Phase B-5.1): accountDeletionBlocks/{uid} is created
//   first. While it exists, nothing under users/{uid} can be created or
//   updated (a stale device of the deleted account can't re-create data);
//   hard deletes by the owner stay allowed so the deletion can finish.
// Everything else (any other path) is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function hasDeletedFlag() {
      return request.resource.data.deleted is bool;
    }

    // The account is being/was deleted: no new or changed user data.
    function notBlocked(uid) {
      return !exists(/databases/$(database)/documents/accountDeletionBlocks/$(uid));
    }

    // Minimal security record of a deleted account: id = uid, only
    // "deletedAt" (server time). Created once by the owner; never changed
    // or removed by a client; readable only by the owner.
    match /accountDeletionBlocks/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
                    && request.resource.data.keys().hasOnly(['deletedAt'])
                    && request.resource.data.deletedAt == request.time;
      allow update, delete: if false;
    }

    // An update may not revive a deleted document.
    function keepsDeletion() {
      return resource.data.get('deleted', false) != true
          || request.resource.data.deleted == true;
    }

    match /users/{uid}/songs/{songId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
                    && notBlocked(uid)
                    && request.resource.data.syncId == songId
                    && hasDeletedFlag();
      allow update: if isOwner(uid)
                    && notBlocked(uid)
                    && request.resource.data.syncId == songId
                    && hasDeletedFlag()
                    && keepsDeletion();
      // Hard delete: only "계정 및 클라우드 데이터 삭제" (Phase B-5) uses it;
      // normal sync never deletes and keeps using `deleted: true`. Allowed
      // even while blocked, so the deletion can finish.
      allow delete: if isOwner(uid);
    }

    match /users/{uid}/folders/{folderId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
                    && notBlocked(uid)
                    && request.resource.data.syncId == folderId
                    && hasDeletedFlag();
      allow update: if isOwner(uid)
                    && notBlocked(uid)
                    && request.resource.data.syncId == folderId
                    && hasDeletedFlag()
                    && keepsDeletion();
      // Hard delete: only "계정 및 클라우드 데이터 삭제" (Phase B-5) uses it;
      // normal sync never deletes and keeps using `deleted: true`. Allowed
      // even while blocked, so the deletion can finish.
      allow delete: if isOwner(uid);
    }

    // Memberships carry a revision: every user change (add, remove,
    // re-add, ...) is a new, higher revision. The revision never goes
    // down, and a removed membership can only become live again with a
    // strictly higher revision (an explicit re-add). A removal may reuse
    // the current revision (same generation: the removal wins).
    match /users/{uid}/folderSongs/{docId} {
      function idMatches() {
        return docId == request.resource.data.folderSyncId + '_'
                        + request.resource.data.songSyncId;
      }
      function newRev() {
        return request.resource.data.revision;
      }
      function wasDeleted() {
        return resource.data.get('deleted', false) == true;
      }
      // Documents written before revisions existed: live 1, deleted 2.
      function oldRev() {
        return wasDeleted()
            ? resource.data.get('revision', 2)
            : resource.data.get('revision', 1);
      }
      function revisionOk() {
        return newRev() is int
            && newRev() >= oldRev()
            && (!wasDeleted()
                || request.resource.data.deleted == true
                || newRev() > oldRev());
      }
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
                    && notBlocked(uid)
                    && idMatches()
                    && hasDeletedFlag()
                    && newRev() is int
                    && newRev() >= 1;
      allow update: if isOwner(uid)
                    && notBlocked(uid)
                    && idMatches()
                    && hasDeletedFlag()
                    && revisionOk();
      // Hard delete: only "계정 및 클라우드 데이터 삭제" (Phase B-5) uses it;
      // normal sync never deletes and keeps using `deleted: true`. Allowed
      // even while blocked, so the deletion can finish.
      allow delete: if isOwner(uid);
    }
  }
}
